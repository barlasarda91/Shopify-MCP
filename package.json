{
  "name": "shopify-mcp",
  "version": "1.0.0",
  "description": "MCP server that gives Claude access to the Shopify Admin API",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "shopify-mcp": "build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "start": "node build/index.js",
    "start:http": "node build/http.js",
    "watch": "tsc --watch"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "shopify",
    "claude",
    "model-context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^5.2.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
